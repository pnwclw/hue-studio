{
  "services": {
    "apply_palette": {
      "service": "mdi:palette"
    },
    "set_gradient": {
      "service": "mdi:gradient-horizontal"
    },
    "set_effect": {
      "service": "mdi:creation"
    },
    "save_scene": {
      "service": "mdi:content-save"
    },
    "reset_scene": {
      "service": "mdi:restore"
    },
    "recall_scene": {
      "service": "mdi:play-circle-outline"
    },
    "set_sync": {
      "service": "mdi:television-ambient-light"
    },
    "apply_auto_light": {
      "service": "mdi:lightbulb-auto"
    },
    "save_sync_preset": {
      "service": "mdi:content-save-outline"
    },
    "delete_sync_preset": {
      "service": "mdi:delete-outline"
    },
    "learn_sync_ir_code": {
      "service": "mdi:remote"
    },
    "set_sync_ir_code": {
      "service": "mdi:remote-tv"
    },
    "delete_sync_ir_code": {
      "service": "mdi:remote-off"
    }
  },
  "entity": {
    "switch": {
      "power": {
        "default": "mdi:power"
      },
      "light_sync": {
        "default": "mdi:television-ambient-light",
        "state": {
          "off": "mdi:television"
        }
      }
    },
    "select": {
      "sync_mode": {
        "default": "mdi:sync",
        "state": {
          "video": "mdi:movie-open",
          "music": "mdi:music",
          "game": "mdi:gamepad-variant"
        }
      },
      "intensity": {
        "default": "mdi:sine-wave"
      },
      "hdmi_input": {
        "default": "mdi:hdmi-port"
      },
      "entertainment_area": {
        "default": "mdi:sofa-outline"
      },
      "led_indicator": {
        "default": "mdi:led-on"
      },
      "light_control": {
        "default": "mdi:lightbulb-auto",
        "state": {
          "auto": "mdi:lightbulb-auto",
          "manual": "mdi:hand-back-right",
          "off": "mdi:lightbulb-off-outline"
        }
      }
    },
    "number": {
      "brightness": {
        "default": "mdi:brightness-6"
      },
      "light_offset": {
        "default": "mdi:brightness-6"
      }
    },
    "sensor": {
      "hdmi1_status": {
        "default": "mdi:hdmi-port"
      },
      "hdmi2_status": {
        "default": "mdi:hdmi-port"
      },
      "hdmi3_status": {
        "default": "mdi:hdmi-port"
      },
      "hdmi4_status": {
        "default": "mdi:hdmi-port"
      },
      "content_info": {
        "default": "mdi:information-outline"
      },
      "bridge_connection": {
        "default": "mdi:bridge"
      },
      "wifi_quality": {
        "default": "mdi:wifi"
      },
      "light_phase": {
        "default": "mdi:theme-light-dark",
        "state": {
          "morning": "mdi:weather-sunset-up",
          "day": "mdi:white-balance-sunny",
          "golden": "mdi:weather-sunset",
          "evening": "mdi:weather-sunset-down",
          "night": "mdi:weather-night"
        }
      },
      "light_scene": {
        "default": "mdi:palette-swatch-variant"
      },
      "light_brightness": {
        "default": "mdi:brightness-percent"
      }
    },
    "button": {
      "next_light_scene": {
        "default": "mdi:skip-next"
      }
    }
  }
}
